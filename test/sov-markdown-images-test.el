(ert-deftest sov-markdown-images-repeated-shrinking-evicts-old-variants-and-stops-at-one-pixel ()
  (with-temp-buffer
    (insert "![](image.png)")
    (let ((overlay (make-overlay 1 (point-max)))
          (sov-markdown-image-zoom-factor 1.1)
          (measurements 0)
          flushed)
      (overlay-put overlay 'display '(image :type png :file "/tmp/image.png" :scale 1.0))
      (setq markdown-inline-image-overlays (list overlay))
      (goto-char 2)
      (cl-letf (((symbol-function 'image-size)
                 (lambda (&rest _) (cl-incf measurements) '(1000 . 800)))
                ((symbol-function 'image-flush)
                 (lambda (image &rest _) (push (copy-tree image) flushed))))
        (dotimes (_ 100)
          (sov-markdown-image-decrease-size))
        (should (= measurements 1))
        (should (= (overlay-get overlay 'sov-markdown-image-scale) (/ 1.0 800)))
        (should (> (length flushed) 50))
        (let ((count (length flushed))
              (image (overlay-get overlay 'display)))
          (sov-markdown-image-decrease-size)
          (should (= (length flushed) count))
          (should (eq image (overlay-get overlay 'display))))))))

