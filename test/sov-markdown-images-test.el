(ert-deftest sov-markdown-images-memory-preview-uses-stdin-and-no-disk-cache ()
  (sov-markdown-images-test--with-note
    (let ((file (expand-file-name "image [1].png" directory))
          (coding-system-for-write 'no-conversion)
          calls)
      (write-region sov-markdown-images-test--png nil file nil 'silent)
      (cl-letf (((symbol-function 'executable-find) (lambda (_) "/usr/bin/magick"))
                ((symbol-function 'call-process)
                 (lambda (program input destination display &rest arguments)
                   (push (list program input destination display arguments) calls)
                   (should-not enable-multibyte-characters)
                   (insert sov-markdown-images-test--png)
                   0))
                ((symbol-function 'create-image)
                 (lambda (data type data-p &rest properties)
                   (should data-p)
                   `(image :type ,type :data ,data ,@properties))))
        ;; This test exercises the converter, rather than the fixture's stub.
        (cl-letf (((symbol-function 'sov-markdown--memory-image-preview)
                   (symbol-function 'sov-markdown-images-test--real-preview)))
          (let ((image (sov-markdown--memory-image-preview
                        `(image :type png :file ,file) 600 400 2.0)))
            (should (equal (image-property image :data) sov-markdown-images-test--png))
            (should-not (image-property image :file))
            (should (= (image-property image :scale) 0.5)))))
      (should (= (length calls) 1))
      (pcase-let ((`(,program ,input ,destination ,display ,arguments) (car calls)))
        (should (equal program "/usr/bin/magick"))
        (should (equal input file))
        (should (equal destination '(t nil)))
        (should-not display)
        (should (equal arguments
                       '("-limit" "map" "0" "-limit" "disk" "0"
                         "-limit" "thread" "1" "-[0]" "-resize" "1200x800!"
                         "-strip" "png:-"))))
      (should (equal (directory-files directory nil "^[^.]") '("image [1].png"))))))

(ert-deftest sov-markdown-images-memory-preview-replaces-one-variant-and-keeps-source ()
  (with-temp-buffer
    (insert "![](image.png)")
    (let* ((overlay (make-overlay 1 (point-max)))
           (source '(image :type png :file "/tmp/image.png" :scale 1.0))
           (calls 0)
           flushed)
      (overlay-put overlay 'display source)
      ;; Existing buffers may already have dimensions cached by older code.
      (overlay-put overlay 'sov-markdown-image-native-size '(1000 . 800))
      (setq markdown-inline-image-overlays (list overlay))
      (cl-letf (((symbol-function 'image-size)
                 (lambda (&rest _) (ert-fail "Use cached original dimensions")))
                ((symbol-function 'frame-scale-factor) (lambda (&rest _) 2.0))
                ((symbol-function 'sov-markdown--memory-image-preview)
                 (lambda (original width height density)
                   (should (equal original source))
                   (should (= density 2.0))
                   (cl-incf calls)
                   `(image :type png :data ,(format "%dx%d" width height) :scale 0.5)))
                ((symbol-function 'image-flush)
                 (lambda (image &rest _) (push image flushed))))
        (sov-markdown--set-image-scale overlay 0.5)
        (let ((preview (overlay-get overlay 'display)))
          (sov-markdown--set-image-scale overlay 0.5)
          (should (eq preview (overlay-get overlay 'display)))
          (should (= calls 1))
          (sov-markdown--zoom-image overlay 1.1)
          (should (= calls 2))
          (should (equal (image-property (overlay-get overlay 'display) :data) "550x440"))
          (should (memq preview flushed)))
        (should (equal (overlay-get overlay 'sov-markdown-image-source) source))
        (should (equal (sov-markdown--image-native-size overlay) '(1000 . 800)))
        (should (< (abs (- (overlay-get overlay 'sov-markdown-image-scale) 0.55)) 0.000001))
        ;; Also release the current decoded pixels when the note is closed.
        (let ((preview (overlay-get overlay 'display)))
          (sov-markdown--clear-image-previews)
          (should (memq preview flushed))
          (should-not (overlay-buffer overlay))
          (should-not (overlay-get overlay 'display))
          (should-not markdown-inline-image-overlays))))))

