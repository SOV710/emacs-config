;;; sov-markdown-images-test.el --- Clipboard image integration tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'evil)
(require 'markdown-mode)
(require 'projectile)

;; Exercise the module without starting Elpaca or unrelated package hooks.
(defmacro use-package (&rest _args) nil)

(require 'sov-lang-markdown)

(defconst sov-markdown-images-test--png
  (base64-decode-string
   "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aX1sAAAAASUVORK5CYII="))

(defmacro sov-markdown-images-test--with-note (&rest body)
  (declare (indent 0) (debug t))
  `(let ((directory (make-temp-file "sov-markdown-images-" t))
         (sov-markdown-image-directory "assets/")
         (sov-markdown-image-scale 1.0)
         ;; Detect real .projectile markers inside each fixture, independently
         ;; of Git metadata or other project markers in the test machine's /tmp.
         (projectile-project-root-functions '(projectile-root-marked))
         (projectile-project-root-cache (make-hash-table :test 'equal)))
     (unwind-protect
         (with-temp-buffer
           (setq buffer-file-name (expand-file-name "note.md" directory)
                 default-directory directory)
           (let ((markdown-mode-hook nil))
             (markdown-mode))
           (cl-letf (((symbol-function 'image-size) (lambda (&rest _) '(1000 . 800)))
                     ((symbol-function 'image-flush) #'ignore))
                    ,@body))
       (delete-directory directory t))))

(ert-deftest sov-markdown-images-paste-preserves-bytes-and-renders-relative-link ()
  (sov-markdown-images-test--with-note
    (let ((prompts 0)
          rendered-file rendered-scale)
      (cl-letf (((symbol-function 'read-string)
                 (lambda (&rest _args) (cl-incf prompts) "图片 (v1.2)"))
                ((symbol-function 'gui-get-selection)
                 (lambda (_selection target &rest _args)
                   (if (eq target 'TARGETS)
                       [image/png]
                     sov-markdown-images-test--png)))
                ((symbol-function 'image-type-available-p) (lambda (_) t))
                ((symbol-function 'display-images-p) (lambda (&rest _) t))
                ((symbol-function 'clear-image-cache) #'ignore)
                ((symbol-function 'sov-markdown--image-window-limits)
                 (lambda () '(800 400 10)))
                ((symbol-function 'create-image)
                 (lambda (file &rest args)
                   (setq rendered-file file
                         rendered-scale (plist-get (cddr args) :scale))
                   `(image :type png :file ,file :scale ,rendered-scale))))
        ;; The note location, rather than a changed default-directory, wins.
        (let ((default-directory temporary-file-directory))
          (call-interactively #'sov-markdown-paste-image)))
      (should (= prompts 1))
      (should (equal (buffer-string) "![](assets/图片%20%28v1.2%29.png)"))
      (should (equal rendered-file
                     (expand-file-name "assets/图片 (v1.2).png" directory)))
      (should (equal rendered-scale 1.0))
      (should (= (length markdown-inline-image-overlays) 1))
      (should (overlay-get (car markdown-inline-image-overlays) 'evaporate))
      (should (= (image-property
                  (overlay-get (car markdown-inline-image-overlays) 'display)
                  :scale)
                 0.5))
      (with-temp-buffer
        (set-buffer-multibyte nil)
        (insert-file-contents-literally rendered-file)
        (should (equal (buffer-string) sov-markdown-images-test--png))))))

(ert-deftest sov-markdown-images-save-to-projectile-root-assets ()
  (sov-markdown-images-test--with-note
    (with-temp-file (expand-file-name ".projectile" directory))
    (let* ((note-directory (expand-file-name "docs/notes/" directory))
           (image (expand-file-name "assets/diagram.png" directory)))
      (make-directory note-directory t)
      (setq buffer-file-name (expand-file-name "note.md" note-directory))
      (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "diagram")))
        ;; A changed working directory must not select a different project.
        (let ((default-directory temporary-file-directory))
          (sov-markdown--yank-image 'image/png sov-markdown-images-test--png)))
      (should (file-exists-p image))
      (should-not (file-exists-p (expand-file-name "assets/" note-directory)))
      (should (equal (buffer-string) "![](../../assets/diagram.png)"))
      (with-temp-buffer
        (set-buffer-multibyte nil)
        (insert-file-contents-literally image)
        (should (equal (buffer-string) sov-markdown-images-test--png))))))

(ert-deftest sov-markdown-images-outside-project-use-note-directory-assets ()
  (sov-markdown-images-test--with-note
    (let ((note-directory (expand-file-name "notes/" directory)))
      (make-directory note-directory t)
      (should-not (projectile-project-root note-directory))
      (setq buffer-file-name (expand-file-name "note.md" note-directory))
      (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "diagram")))
        (sov-markdown--yank-image 'image/png sov-markdown-images-test--png))
      (should (file-exists-p
               (expand-file-name "assets/diagram.png" note-directory)))
      (should-not (file-exists-p (expand-file-name "assets/" directory)))
      (should (equal (buffer-string) "![](assets/diagram.png)")))))

(ert-deftest sov-markdown-images-empty-name-uses-time-format ()
  (sov-markdown-images-test--with-note
    (let ((sov-markdown-image-name-format "test-%Y%m%d-%H%M%S"))
      (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "")))
        (sov-markdown--yank-image 'image/png sov-markdown-images-test--png))
      (should (string-match-p
               "!\\[\\](assets/test-[0-9]\\{8\\}-[0-9]\\{6\\}\\.png)"
               (buffer-string))))))

(ert-deftest sov-markdown-images-format-comes-from-binary-data ()
  (sov-markdown-images-test--with-note
    (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "diagram.jpeg")))
      ;; Even a conflicting MIME label must not change the detected format.
      (sov-markdown--yank-image 'image/jpeg sov-markdown-images-test--png))
    (should (equal (buffer-string) "![](assets/diagram.jpeg.png)"))))

(ert-deftest sov-markdown-images-refuse-overwrite-and-directory-names ()
  (sov-markdown-images-test--with-note
    (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "diagram")))
      (sov-markdown--yank-image 'image/png sov-markdown-images-test--png)
      (let ((text (buffer-string)))
        (should-error
         (sov-markdown--yank-image 'image/png sov-markdown-images-test--png)
         :type 'file-already-exists)
        (should (equal text (buffer-string)))))
    (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "../escape")))
      (should-error
       (sov-markdown--yank-image 'image/png sov-markdown-images-test--png)
       :type 'user-error))))

(ert-deftest sov-markdown-images-evil-binding-works-in-both-modes-and-states ()
  (let ((evil-mode-hook nil))
    (evil-mode 1))
  (evil-set-leader 'normal (kbd "SPC"))
  (dolist (mode '(markdown-mode gfm-mode markdown-ts-mode))
    (when (or (not (eq mode 'markdown-ts-mode))
              (and (fboundp mode) (treesit-ready-p 'markdown t)
                   (treesit-ready-p 'markdown-inline t)))
      (with-temp-buffer
        (let ((markdown-mode-hook nil)
              (gfm-mode-hook nil)
              (markdown-ts-mode-hook nil))
          (funcall mode))
        (evil-local-mode 1)
        (sov-markdown-image-setup)
        (dolist (state '(normal insert))
          (evil-change-state state)
          (should (eq (key-binding (kbd "C-c y"))
                      #'sov-markdown-paste-image))
          (should-not (eq (key-binding (kbd "C-S-v"))
                          #'sov-markdown-paste-image)))
        (evil-normal-state)
        (should (eq (key-binding (kbd "+")) #'sov-markdown-image-increase-size))
        (should (eq (key-binding (kbd "-")) #'sov-markdown-image-decrease-size))
        (should (eq (key-binding (kbd "SPC i f")) #'sov-markdown-fit-images))
        (should-not (eq (key-binding (kbd "SPC I F")) #'sov-markdown-fit-images))
        (evil-insert-state)
        (should-not (eq (key-binding (kbd "+")) #'sov-markdown-image-increase-size))
        (should-not (eq (key-binding (kbd "-")) #'sov-markdown-image-decrease-size))
        (should-not (memq #'sov-markdown--schedule-image-resize
                          window-size-change-functions))
        (should-not (memq #'sov-markdown--schedule-image-resize
                          window-buffer-change-functions))))))

(ert-deftest sov-markdown-images-unsaved-or-read-only-note-does-not-read-clipboard ()
  (with-temp-buffer
    (should-error (sov-markdown-paste-image) :type 'user-error)
    (setq buffer-file-name "/tmp/read-only-note.md"
          buffer-read-only t)
    (should-error (sov-markdown-paste-image) :type 'buffer-read-only)))

(ert-deftest sov-markdown-images-fit-once-and-zoom-without-window-measurements ()
  (with-temp-buffer
    (insert "  ![](assets/diagram.png)")
    (let* ((sov-markdown-image-scale 1.0)
           (sov-markdown-image-zoom-factor 1.1)
           (original '(image :type png :file "/tmp/diagram.png" :scale 1.0))
           (overlay (make-overlay 3 (point-max)))
           (text (buffer-string))
           flushed)
      (cl-letf (((symbol-function 'image-size) (lambda (&rest _) '(1000 . 800)))
                ((symbol-function 'image-flush)
                 (lambda (image &rest _) (push (copy-tree image) flushed))))
	(overlay-put overlay 'display original)
	(setq markdown-inline-image-overlays (list overlay))
	(sov-markdown--fit-image overlay '(800 400 10))
	(let ((image (overlay-get overlay 'display)))
          (should-not (image-property image :max-width))
          (should-not (image-property image :max-height))
          (should (= (image-property image :scale) 0.5))
          (should-not (image-property image :width))
          (should-not (image-property image :height)))
	(goto-char 5)
	(let ((fitted (copy-tree (overlay-get overlay 'display))))
          (cl-letf (((symbol-function 'sov-markdown--image-window-limits)
                     (lambda () (ert-fail "Manual zoom must not measure windows")))
                    ((symbol-function 'run-with-timer)
                     (lambda (&rest _) (ert-fail "No resize timers")))
                    ((symbol-function 'run-with-idle-timer)
                     (lambda (&rest _) (ert-fail "No delayed zoom")))
                    ((symbol-function 'force-window-update)
                     (lambda (&rest _) (ert-fail "No forced whole-window redraw"))))
            (sov-markdown-image-increase-size)
            (should (< (abs (- (image-property (overlay-get overlay 'display) :scale)
                               0.55))
                       0.000001))
            (should-not (image-property (overlay-get overlay 'display) :max-width))
            (should-not (image-property (overlay-get overlay 'display) :max-height))
            (sov-markdown-image-decrease-size)
            (should (equal fitted (overlay-get overlay 'display)))
            ;; Repeated inverse operations must not accumulate pixel rounding.
            (dotimes (_ 10)
              (sov-markdown-image-increase-size)
              (sov-markdown-image-decrease-size))
            (should (equal fitted (overlay-get overlay 'display)))))
	(should (equal original '(image :type png :file "/tmp/diagram.png" :scale 1.0)))
	(should (equal text (buffer-string)))
	(should (= (length flushed) 23))
	(should (= (image-property (car (last flushed)) :scale) 1.0))))))

(ert-deftest sov-markdown-images-insertion-preserves-other-zoom-and-fit-all-is-explicit ()
  (sov-markdown-images-test--with-note
    (let ((name "first")
          (limits '(800 400 10))
          (measurements 0)
          (sov-markdown-image-zoom-factor 1.1))
      (cl-letf (((symbol-function 'read-string) (lambda (&rest _) name))
                ((symbol-function 'display-images-p) (lambda (&rest _) t))
                ((symbol-function 'create-image)
                 (lambda (file &rest args)
                   `(image :type png :file ,file
                           :scale ,(or (plist-get (cddr args) :scale) 'default))))
                ((symbol-function 'sov-markdown--image-window-limits)
                 (lambda () (cl-incf measurements) (copy-sequence limits)))
                ((symbol-function 'clear-image-cache)
                 (lambda (&rest _) (ert-fail "Do not flush the global image cache")))
                ((symbol-function 'run-with-timer)
                 (lambda (&rest _) (ert-fail "No dynamic resize timer")))
                ((symbol-function 'run-with-idle-timer)
                 (lambda (&rest _) (ert-fail "No idle resize timer"))))
        (sov-markdown--yank-image 'image/png sov-markdown-images-test--png)
        (let ((first (car markdown-inline-image-overlays)))
          (goto-char (overlay-start first))
          (sov-markdown-image-increase-size)
          (let ((zoomed (overlay-get first 'display)))
            (goto-char (point-max))
            (insert "\n")
            (setq name "second")
            (sov-markdown--yank-image 'image/png sov-markdown-images-test--png)
            (should (= measurements 2))
            (should (= (length markdown-inline-image-overlays) 2))
            (should (eq zoomed (overlay-get first 'display)))
            ;; Geometry changes alone do not cause measurement or resizing.
            (setq limits '(500 200 10))
            (should (eq zoomed (overlay-get first 'display)))
            (should (= measurements 2)))
          (let ((text (buffer-string)))
            (sov-markdown-fit-images)
            (should (= measurements 3))
            (should (= (length markdown-inline-image-overlays) 2))
            (dolist (overlay markdown-inline-image-overlays)
              (let ((image (overlay-get overlay 'display)))
                (should-not (image-property image :max-width))
                (should-not (image-property image :max-height))
                (should (= (image-property image :scale) 0.25))))
            (should (equal text (buffer-string)))))))))

(ert-deftest sov-markdown-images-opening-note-fits-once-without-background-resizing ()
  (sov-markdown-images-test--with-note
    (let ((file (expand-file-name "diagram.png" directory))
          (coding-system-for-write 'no-conversion)
          (measurements 0))
      (write-region sov-markdown-images-test--png nil file nil 'silent)
      (insert "![](diagram.png)")
      (cl-letf (((symbol-function 'display-images-p) (lambda (&rest _) t))
                ((symbol-function 'create-image)
                 (lambda (file &rest _) `(image :type png :file ,file :scale default)))
                ((symbol-function 'sov-markdown--image-window-limits)
                 (lambda () (cl-incf measurements) '(800 400 10)))
                ((symbol-function 'run-with-timer)
                 (lambda (&rest _) (ert-fail "Opening must not schedule resizing"))))
        (sov-markdown-image-setup))
      (should (= (length markdown-inline-image-overlays) 1))
      (should (= measurements 1))
      (let ((image (overlay-get (car markdown-inline-image-overlays) 'display)))
        (should (= (image-property image :scale) 0.5))
        (should-not (image-property image :max-width))
        (should-not (image-property image :max-height))))))

(ert-deftest sov-markdown-images-repeated-shrinking-evicts-old-variants-and-stops-at-one-pixel ()
  (with-temp-buffer
    (insert "![](image.png)")
    (let ((overlay (make-overlay 1 (point-max)))
          (sov-markdown-image-zoom-factor 1.1)
          (measurements 0)
          flushed)
      (overlay-put overlay 'display '(image :type png :file "/tmp/image.png" :scale 1.0))
      (setq markdown-inline-image-overlays (list overlay))
      (goto-char 2)
      (cl-letf (((symbol-function 'image-size)
                 (lambda (&rest _) (cl-incf measurements) '(1000 . 800)))
                ((symbol-function 'image-flush)
                 (lambda (image &rest _) (push (copy-tree image) flushed))))
        (dotimes (_ 100)
          (sov-markdown-image-decrease-size))
        (should (= measurements 1))
        (should (= (image-property (overlay-get overlay 'display) :scale) (/ 1.0 800)))
        (should (> (length flushed) 50))
        (let ((count (length flushed))
              (image (overlay-get overlay 'display)))
          (sov-markdown-image-decrease-size)
          (should (= (length flushed) count))
          (should (eq image (overlay-get overlay 'display))))))))

(ert-deftest sov-markdown-images-plus-minus-preserve-evil-motions-away-from-images ()
  (with-temp-buffer
    (insert "first\n  second\nthird\n")
    (goto-char (point-min))
    (evil-local-mode 1)
    (evil-normal-state)
    (sov-markdown-image-increase-size)
    (should (= (line-number-at-pos) 2))
    (should (= (current-column) 2))
    (sov-markdown-image-decrease-size)
    (should (= (point) (point-min)))))

