(ert-deftest sov-markdown-images-deleting-link-releases-preview ()
  (dolist (deletion '(exact across))
    (ert-info ((format "Deletion: %s" deletion))
      (sov-markdown-images-test--with-note
        (insert "before\n")
        (let* ((start (point))
               (overlay (progn
                          (insert "![](image.png)")
                          (make-overlay start (point))))
               (preview `(image :type png :data ,sov-markdown-images-test--png))
               flushed)
          (insert "\nafter\n")
          (overlay-put overlay 'display '(image :type png :file "/tmp/image.png"))
          (setq markdown-inline-image-overlays (list overlay))
          (cl-letf (((symbol-function 'sov-markdown--memory-image-preview)
                     (lambda (&rest _) preview))
                    ((symbol-function 'image-flush)
                     (lambda (image frame)
                       (should (eq frame t))
                       (push image flushed))))
            (sov-markdown--set-image-scale overlay 0.5)
            (setq flushed nil)
            (if (eq deletion 'exact)
                (delete-region (overlay-start overlay) (overlay-end overlay))
              (delete-region (point-min) (point-max)))
            (should (equal flushed (list preview)))
            (should-not (overlay-buffer overlay))
            (should-not (overlay-get overlay 'display))
            (should-not markdown-inline-image-overlays)
            ;; Subsequent refresh/close cleanup must not flush a nil image.
            (sov-markdown--clear-image-previews)
            (should (= (length flushed) 1))))))))

(ert-deftest sov-markdown-images-edits-only-notify-affected-previews ()
  (sov-markdown-images-test--with-note
    (insert "before\n")
    (dotimes (_ 2)
      (let ((start (point)))
        (insert "![](image.png)")
        (let ((overlay (make-overlay start (point))))
          (overlay-put overlay 'display '(image :type png :file "/tmp/image.png"))
          (push overlay markdown-inline-image-overlays)
          (sov-markdown--set-image-scale overlay 0.5)))
      (insert "\n"))
    (insert "after\n")
    (let* ((first (cadr markdown-inline-image-overlays))
           (second (car markdown-inline-image-overlays))
           (first-image (overlay-get first 'display))
           (second-image (overlay-get second 'display))
           (handler (symbol-function 'sov-markdown--image-preview-modified))
           callbacks flushed)
      (cl-letf (((symbol-function 'sov-markdown--image-preview-modified)
                 (lambda (overlay &rest args)
                   (push overlay callbacks)
                   (apply handler overlay args)))
                ((symbol-function 'image-flush)
                 (lambda (image &rest _) (push image flushed))))
        (dotimes (_ 10000)
          (goto-char (point-max))
          (insert "x")
          (delete-char -1))
        (should-not callbacks)
        ;; Fontification can touch both overlays without deleting their text.
        (put-text-property (point-min) (point-max) 'face 'bold)
        (should callbacks)
        (should-not flushed)
        (should (eq first-image (overlay-get first 'display)))
        (should (eq second-image (overlay-get second 'display)))
        (setq callbacks nil)
        (delete-region (1+ (overlay-start first)) (+ 3 (overlay-start first)))
        (goto-char (1+ (overlay-start first)))
        (insert "replacement")
        (should callbacks)
        (should (cl-every (lambda (overlay) (eq overlay first)) callbacks))
        (should-not flushed)
        (should (eq first-image (overlay-get first 'display)))
        (delete-region (overlay-start first) (overlay-end first))
        (should (equal flushed (list first-image)))
        (should (equal markdown-inline-image-overlays (list second)))
        (should (eq second-image (overlay-get second 'display)))))))

(ert-deftest sov-markdown-images-deleted-preview-bytes-are-collectible ()
  (with-temp-buffer
    (let ((previews (make-hash-table :test 'eq :weakness 'key))
          (releases 0))
      (setq-local markdown-inline-image-overlays nil)
      (cl-letf (((symbol-function 'sov-markdown--memory-image-preview)
                 (lambda (&rest _)
                   (let ((data (make-string 1024 ?x)))
                     (puthash data t previews)
                     `(image :type png :data ,data))))
                ((symbol-function 'image-flush)
                 (lambda (image &rest _)
                   (when (image-property image :data)
                     (cl-incf releases)))))
        (dotimes (_ 100)
          (insert "![](image.png)")
          (let ((overlay (make-overlay (point-min) (point-max))))
            (overlay-put overlay 'display '(image :type png :file "/tmp/image.png"))
            (overlay-put overlay 'sov-markdown-image-native-size '(1000 . 800))
            (push overlay markdown-inline-image-overlays)
            (sov-markdown--set-image-scale overlay 0.5))
          (delete-region (point-min) (point-max)))
        (garbage-collect)
        (should (= releases 100))
        (should-not markdown-inline-image-overlays)
        (should (= (hash-table-count previews) 0))))))

(defalias 'sov-markdown-images-test--real-preview
  (symbol-function 'sov-markdown--memory-image-preview))

